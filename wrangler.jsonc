{
  "name": "hukamnama",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "sggs.dosanjhlabs.com", "custom_domain": true },
    { "pattern": "dasam.dosanjhlabs.com", "custom_domain": true },
    { "pattern": "sarbloh.dosanjhlabs.com", "custom_domain": true },
    { "pattern": "hukamnama.dosanjhlabs.com", "custom_domain": true },
    { "pattern": "hukam.dosanjhlabs.com", "custom_domain": true }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
